# Standalone mode (default): no database needed. Backend runs on in-memory data
# that resets every restart - great for building/demoing the frontend without
# fighting with Postgres setup. See README.md "Standalone mode vs connected mode".
USE_MOCK_DB=true

# Only used when USE_MOCK_DB=false (connected mode).
# If your password contains @, URL-encode it (e.g. @ -> %40).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/regimens

# REQUIRED: use a long random secret (32+ chars). Never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=12h
PORT=4000

# Comma-separated browser origins allowed to call the API.
# Localhost / 127.0.0.1 are always allowed by the server.
# On Render, include *.vercel.app (and/or your exact Vercel URL):
# CORS_ORIGIN=*.vercel.app,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,*.vercel.app

# Set true on hosted Postgres (Render, Railway, Neon, …)
DATABASE_SSL=false

# Optional. Lets staff set a new password on /forgot without email.
# Required in production (8+ characters). Mock mode falls back to regimens-reset.
# ACCOUNT_RECOVERY_CODE=change-this-shop-code

# Optional rate limits
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=20
