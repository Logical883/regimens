{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm run deploy:prepare",
  "buildCommand": "node scripts/vercel-api-build.js",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{backend/**,database/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
